{
  "name": "flexpulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:chat\"",
    "dev:client": "vite",
    "dev:chat": "node --env-file=.env server/chat-server.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext .ts,.tsx",
    "preview": "vite preview",
    "test": "vitest run && node --test server/chat-server.node.mjs"
  },
  "dependencies": {
